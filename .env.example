# Powerword Environment Configuration Template
# Copy this file to .env and fill in your keys.

POWERWORD_GEMINI_API_KEY=your_gemini_api_key_here
POWERWORD_OPENAI_API_KEY=your_openai_api_key_here
POWERWORD_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default active model to run
POWERWORD_MODEL=gemini-1.5-pro

# Set to true to enable verbose debugging logs
POWERWORD_VERBOSE=false
